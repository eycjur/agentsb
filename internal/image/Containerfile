# Ref: https://hub.docker.com/layers/docker/sandbox-templates/shell-docker/images/sha256-88e4148d65a987a173556f52b3dea0c492f037b572a42f69270a634d8c86f378
FROM docker/sandbox-templates:shell-docker

ARG YAZI_VERSION=26.5.6

ENV DEBIAN_FRONTEND=noninteractive
ENV IS_SANDBOX=1

USER root

# 以下のパッケージはベースイメージに含まれている
# ca-certificates curl git jq less make nodejs python3 sudo
#
# sbx のプロキシは archive.ubuntu.com:80 への dial に失敗することがあるため、HTTPS に切り替える。
RUN sed -i \
      -e 's|http://archive.ubuntu.com/ubuntu/|https://archive.ubuntu.com/ubuntu/|g' \
      -e 's|http://security.ubuntu.com/ubuntu/|https://security.ubuntu.com/ubuntu/|g' \
      /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      fzf gh python-is-python3 vim zsh && \
    curl https://mise.run | sh && \
    UV_TOOL_DIR=/usr/local/share/uv/tools UV_TOOL_BIN_DIR=/usr/local/bin \
      uv tool install yazi-bin==${YAZI_VERSION} && \
    chsh -s /bin/zsh agent && \
    rm -rf /var/lib/apt/lists/*

USER agent
# サンドボックス内ではキーチェーンが使えないため、認証はファイルストアに固定する。
# 認証情報ファイルは `sbx cp` でサンドボックス作成後にコピーする
# （internal/home 参照）。コピー先の親ディレクトリだけ先に用意しておく。
ENV AGENT_CLI_CREDENTIAL_STORE=file
RUN curl https://cursor.com/install -fsS | bash && \
    npm install -g --ignore-scripts=false @anthropic-ai/claude-code @openai/codex hunkdiff && \
    mkdir -p /home/agent/.claude /home/agent/.codex /home/agent/.config/cursor /home/agent/.cursor
